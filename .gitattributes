# These artifacts are verified by byte-level SHA-256 hashes.
# Preserve their bytes across clones, including Windows core.autocrlf setups.
data/** -text
evals/datasets/** -text
evals/results/** -text

# Keep source and docs LF-normalized so code_sha256 and diffs match across OSes.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
