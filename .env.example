# Copie para .env. Nunca versione uma chave real.
APP_GOOGLE_API_KEY=
APP_GOOGLE_API_KEY_FALLBACK_1=
APP_GOOGLE_API_KEY_FALLBACK_2=
APP_RAG_CHAT_MODEL=gemini-3.5-flash
APP_RAG_EMBEDDING_MODEL=models/gemini-embedding-2
# Padrao local consolidado aprovado mais recente (v10, 2.114 evidencias).
# Para rollback rapido ao v9, restaure via `uv run dvc pull` e aponte para:
# data/releases/corpus-consolidado-v9-aprovado-2026-11-12
APP_RAG_RELEASE_DIR=data/releases/corpus-consolidado-v10-aprovado-2026-11-17
APP_RAG_VECTOR_DIR=data/vectorstore/chroma
APP_RAG_TOP_K=5
