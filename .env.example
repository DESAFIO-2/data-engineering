# Copie para .env. Nunca versione uma chave real.
APP_GOOGLE_API_KEY=
APP_GOOGLE_API_KEY_FALLBACK_1=
APP_GOOGLE_API_KEY_FALLBACK_2=
APP_RAG_CHAT_MODEL=gemini-3.5-flash
