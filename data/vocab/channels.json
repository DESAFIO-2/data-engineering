{
  "schema_version": "vocab-channels-v1",
  "description": "Códigos de canal de disponibilização da REME-DF (F03). Os padrões são expressões regulares aplicadas ao texto principal do canal (sem notas de rodapé), em minúsculas e sem acentos. Um canal pode receber vários códigos. Os códigos não afirmam dispensação ao cidadão: só classificam o texto da fonte. Revisão humana na F8 (vocab_channels.csv).",
  "codes": {
    "UBS_FARMACIA_AMBULATORIAL": {"label": "UBS — farmácia ambulatorial", "patterns": ["\\bubs\\b[^,;]*farmacia ambulatorial", "unidades de referencia[^,;]*farmacia ambulatorial"]},
